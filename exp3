EventController.java:

package com.example.event_service;
import org.springframework.web.bind.annotation.*;
@RestController
@RequestMapping("/api")
public class EventController {
   @GetMapping("/events")
   public String getEvents() {
       return """
               Available Events:
               1. Advanced Python Workshop
               2. Java Full Stack Workshop
               3. AI & Machine Learning Seminar
               4. Cloud Computing Bootcamp
               5. Web Development Workshop
               6. Cyber Security Awareness
               7. Data Science Workshop
               8. Android App Development
               """;
   }
   @PostMapping("/register")
   public String registerStudent(@RequestBody Student student) {
       return """
               Registration Successful!
                              
               Name: %s
               Email: %s
               Department: %s
               Selected Event: %s
               """
               .formatted(
                       student.getName(),
                       student.getEmail(),
                       student.getDepartment(),
                       student.getEvent()
               );
   }
}

